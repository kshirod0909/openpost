{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=openpost;Username=openpost;Password=openpost"
  },
  "Jwt": {
    "Issuer": "openpost",
    "Audience": "openpost-web",
    "SigningKey": "",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14
  },
  "MailServer": {
    "Enabled": true,
    "SmtpPort": 25,
    "SubmissionPort": 587,
    "HostName": "mail.example.org",
    "MaxMessageBytes": 26214400,
    "MaxRecipientsPerMessage": 100,
    "MaxMessagesPerMinutePerIp": 60,
    "TlsCertificatePath": null,
    "TlsCertificatePassword": null,
    "RequireAuthForRelay": true
  },
  "Storage": {
    "RootPath": "/var/lib/openpost",
    "MaxAttachmentBytes": 26214400
  },
  "Spam": {
    "Enabled": true,
    "RspamdUrl": null,
    "SpamThreshold": 6.0,
    "SuspectThreshold": 3.0,
    "DeliverSpamToJunk": true
  },
  "Antivirus": {
    "Enabled": false,
    "Host": "clamav",
    "Port": 3310
  },
  "Delivery": {
    "MaxAttempts": 8,
    "SmtpTimeoutSeconds": 30,
    "MaxParallelDeliveries": 4,
    "RequireTls": true,
    "SendBounces": true
  },
  "Bootstrap": {
    "AdminEmail": "admin@localhost",
    "AdminPassword": "",
    "Domain": "localhost"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200,http://localhost:8080"
  },
  "AllowedHosts": "*"
}