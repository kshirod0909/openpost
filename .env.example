# ---------------------------------------------------------------------------
# OpenPost environment. Copy to .env and edit before `docker compose up -d`.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
POSTGRES_DB=openpost
POSTGRES_USER=openpost
POSTGRES_PASSWORD=change-this-database-password

# --- security ---------------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# --- mail identity ----------------------------------------------------------
MAIL_HOSTNAME=mail.example.org
ALLOWED_ORIGINS=https://mail.example.org

# Path is inside the container; mount your PFX at ./certs/openpost.pfx
TLS_CERT_PASSWORD=

# --- first-run bootstrap (only used when the database is empty) -------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DOMAIN=example.org

# --- optional scanners ------------------------------------------------------
# Start with: docker compose --profile spam up -d
RSPAMD_URL=http://rspamd:11333
# Start with: docker compose --profile antivirus up -d
CLAMAV_ENABLED=false
